# =====================================================================
# Variables de entorno — plataforma de tarjetas de lealtad
#
# Copia este archivo a .env.local para desarrollo y carga las mismas
# llaves en Vercel (Settings → Environment Variables).
# NINGÚN valor de aquí está inventado: cada uno dice de dónde sacarlo.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase — Sprint 1 (obligatorias desde ya)
# Panel de Supabase → tu proyecto → Project Settings → API
# ---------------------------------------------------------------------

# "Project URL". Se ve como https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública ("anon public" o "Publishable key"). Va al navegador:
# es segura de exponer porque todo pasa por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave secreta ("service_role" o "Secret key"). SALTA RLS.
# Nunca la pongas en una variable NEXT_PUBLIC_ ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app. En local: http://localhost:3000
# En producción: el dominio que te dé Vercel, sin diagonal final.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------
# Proveedor de pases Wallet — Sprint 2
# ---------------------------------------------------------------------

# 'external' mientras se use un proveedor externo. 'self' cuando se
# migre al motor propio (fase 3).
PASS_PROVIDER=external

# Llave y URL base del proveedor de pases que se contrate. Se sacan del
# panel del proveedor una vez creada la cuenta.
PASS_PROVIDER_API_KEY=
PASS_PROVIDER_BASE_URL=

# ---------------------------------------------------------------------
# WhatsApp Cloud API — Sprint 4
# developers.facebook.com → tu app → WhatsApp → Configuración de la API
# ---------------------------------------------------------------------

# "Phone number ID" del número de prueba o del número de producción.
WHATSAPP_PHONE_NUMBER_ID=

# Token permanente de un usuario del sistema (Business Manager →
# Usuarios del sistema → Generar token). El token temporal vence en 24 h.
WHATSAPP_ACCESS_TOKEN=

# Cadena que tú inventas y capturas igual en la configuración del
# webhook de Meta. Sirve para verificar que el webhook es tuyo.
WHATSAPP_VERIFY_TOKEN=

# "App secret" de la app de Meta (Configuración → Básica). Valida la
# firma de cada webhook entrante.
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------
# Secretos de la propia plataforma — Sprint 3 en adelante
# Genera cada uno con:  openssl rand -base64 32
# ---------------------------------------------------------------------

# Firma el QR del cliente para que caduque a los 90 segundos.
STAMP_HMAC_SECRET=

# Protege los endpoints de cron para que solo Vercel pueda dispararlos.
CRON_SECRET=
